# Copy to .env and fill in real values
APP_ENV=production
DB_HOST=127.0.0.1
DB_NAME=pharma_platform
DB_USER=pharma_user
DB_PASS=strongpassword

# Razorpay  (also settable via admin/settings/payment.php)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google service account  (also settable via admin/settings/google.php)
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=primary

# Mail
MAIL_FROM=no-reply@yourdomain.com